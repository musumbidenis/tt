{
  "name": "rvnp-attendance-bridge",
  "version": "1.0.0",
  "description": "Syncs the attendance register between CouchDB and Google Sheets (run by a GitHub Action)",
  "main": "attendance-bridge.js",
  "scripts": {
    "sync": "node attendance-bridge.js --sync",
    "setup": "node attendance-bridge.js --setup",
    "roster": "node attendance-bridge.js --roster",
    "start": "node attendance-bridge.js --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@googleapis/sheets": "^18.1.1"
  }
}
